# Bruit macOS et sauvegardes
.DS_Store
*.bak
node_modules/

# État Terraform et kubeconfig : ne jamais publier — le kubeconfig contient un
# certificat client qui donne les pleins droits sur le cluster.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/kubeconfig.yaml
terraform/*.tfvars
terraform-gke/.terraform/
terraform-gke/*.tfstate
terraform-gke/*.tfstate.*
terraform-gke/kubeconfig.yaml
# jeton OAuth mis en cache par gke-gcloud-auth-plugin, à côté du kubeconfig
terraform-gke/gke_gcloud_auth_plugin_cache
terraform-gke/*.tfvars
# dossier de transfert temporaire (à supprimer)
.tmp-gke/

# Runbook d'animation : document de préparation personnel (nom, client, tarifs
# éventuels). ArgoCD n'en a pas besoin — il reste dans iCloud.
RUNBOOK.md
Runbook-demos-CCS.docx
make_runbook_docx.js

# Ancien jeu de démonstrations (avril 2026), remplacé par demos/ — conservé en
# local pour mémoire, inutile dans le dépôt.
demo-containers/

# Schémas des démonstrations et générateur du runbook détaillé : les données
# contiennent le nom du formateur et du client — ils restent dans iCloud.
/schemas/

# Fichiers de verrou Office (document ouvert dans Word / PowerPoint)
~$*
